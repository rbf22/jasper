# Tenstorrent venv (project-local)
.tt-venv/

# Python
__pycache__/
*.pyc

# TT-metal generated files (kernel cache, watcher, inspector)
generated/
workspace-poc/generated/
workspace-mvp/generated/

# Per-cell isolated run directories (workdirs, caches, checkpoints, logs)
workspace-poc/run_A/
workspace-poc/run_B/
workspace-poc/run_C/
workspace-poc/run_D/
workspace-poc/run_E/

# Checkpoints, backups, and logs
workspace-poc/checkpoints/
workspace-poc/backups/
workspace-poc/logs/
workspace-mvp/checkpoints/
workspace-mvp/logs/

# Text training data (TinyStories, ~5GB)
workspace-mvp/data/

# Symlinks to venv
workspace-mvp/venv
workspace-mvp/.tt-venv

# TT-metal kernel cache
workspace-poc/tt_cache/
workspace-poc/lib64

# Eval loop runtime
workspace-poc/eval_loop.pid
workspace-poc/eval_loop_*.log

# Temporary bug report
workspace-poc/TT_BUG_REPORT.md

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
